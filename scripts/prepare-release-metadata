#!/bin/sh

set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version_file="$repository_root/VERSION"
template="$repository_root/config/oblinux/os-release.in"
build_id=${1-}
output_root=${2-"$repository_root/config/includes.chroot"}

version=$(cat "$version_file")

if test "$(wc -l < "$version_file" | tr -d ' ')" != 1 || test -z "$version"; then
    echo "VERSION must contain exactly one non-empty newline-terminated line" >&2
    exit 1
fi

if ! printf '%s\n' "$version" | grep -Eq '^[0-9]{2}\.[1-4]\.[0-9]+(-dev)?$'; then
    echo "Invalid OBLinux VERSION: $version" >&2
    exit 1
fi

if ! printf '%s\n' "$build_id" | grep -Eq '^[0-9]{8}-[0-9]{4}$'; then
    echo "BUILD_ID must use YYYYMMDD-HHMM" >&2
    exit 1
fi

for relative_path in etc/os-release usr/lib/os-release; do
    destination="$output_root/$relative_path"
    destination_dir=$(dirname "$destination")
    temporary="$destination.tmp.$$"
    install -d -m 0755 "$destination_dir"
    sed \
        -e "s/@VERSION@/$version/g" \
        -e "s/@BUILD_ID@/$build_id/g" \
        "$template" > "$temporary"
    chmod 0644 "$temporary"
    mv "$temporary" "$destination"
done

cmp "$output_root/etc/os-release" "$output_root/usr/lib/os-release"
