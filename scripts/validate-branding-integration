#!/bin/sh

set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

. branding/brand-master.lock

test "$BRAND_MASTER_VERSION" = v1.0.0
test "$BRAND_MASTER_COMMIT" = 5f8e1d89ce69847f4cca60f82741ff0c779b25b3
test "$BRAND_MASTER_ARCHIVE_SHA256" = 526aadce93f95468b795c2d8c4040b031afb3bea77def98f47e7717fd247785c
test "$BRANDING_PACKAGE_VERSION" = 1.0.0-1

grep -Fq 'scripts/prepare-branding-package' auto/build
grep -Fq 'scripts/validate-branding-integration' auto/build
grep -Fq 'for size in 16 24 32 48 64 96 128 256 512 1024' \
    config/hooks/live/0090-activate-oblinux-brand-master.hook.chroot
grep -Fq 'oblinux-default-light.svg' \
    config/hooks/live/0090-activate-oblinux-brand-master.hook.chroot
grep -Fq 'oblinux-default-dark.svg' \
    config/hooks/live/0090-activate-oblinux-brand-master.hook.chroot
grep -Fq "dpkg-query -W -f='\${Version}' oblinux-branding" \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -Fq '"install ok installed"' \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -Fq '"1.0.0-1"' \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -Fq 'branding: oblinux' \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -Fq 'rm -f "$legacy_brand_dir/$file"' \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -Fq 'rm -f "$legacy_installer_pixmap"' \
    config/hooks/live/0110-verify-oblinux-calamares-branding.hook.chroot
grep -qx 'Theme=oblinux' config/includes.chroot/etc/plymouth/plymouthd.conf
grep -qx 'GRUB_THEME="/usr/share/grub/themes/oblinux/theme.txt"' \
    config/includes.chroot/etc/default/grub.d/99-oblinux.cfg
grep -qx 'LOGO=oblinux-logo' config/includes.chroot/etc/os-release
grep -qx 'ID=oblinux' config/includes.chroot/etc/os-release
grep -qx 'ID_LIKE=debian' config/includes.chroot/etc/os-release
cmp config/includes.chroot/etc/os-release config/includes.chroot/usr/lib/os-release
grep -qx 'Icon=oblinux-installer' \
    config/includes.chroot/usr/share/applications/calamares-install-debian.desktop
grep -Fq 'desktop-image: "background.png"' \
    config/bootloaders/grub-pc/live-theme/theme.txt
grep -Fq 'selected_item_color = "#ff8a00"' \
    config/bootloaders/grub-pc/live-theme/theme.txt

legacy_paths='branding/assets
branding/installer
branding/source
branding/system
branding/wallpapers
config/bootloaders/splash.svg
config/includes.chroot/etc/calamares/branding/debian
config/includes.chroot/usr/share/backgrounds/oblinux
config/includes.chroot/usr/share/grub/themes/oblinux
config/includes.chroot/usr/share/plymouth/themes/oblinux
config/includes.chroot/usr/share/icons/hicolor/scalable/apps/oblinux-logo.svg
config/includes.chroot/usr/share/pixmaps/install-debian.png
config/includes.chroot/usr/share/oblinux/vendor-emblems
config/includes.chroot/usr/share/oblinux/vendor-logos
config/includes.chroot/usr/share/oblinux/branding/oblinux-vendor.svg'
for path in $legacy_paths; do
    test ! -e "$path" || {
        echo "Legacy branding path remains: $path" >&2
        exit 1
    }
done

for hook in config/hooks/live/*.hook.chroot; do
    sh -n "$hook"
done
sh -n scripts/prepare-branding-package
sh -n scripts/validate-branding-integration

if find . \
    \( -path ./.git -o -path ./binary -o -path ./cache -o -path ./chroot \) \
    -prune -o -type l ! -exec test -e {} \; -print | grep -q .; then
    echo "Broken symlink found" >&2
    exit 1
fi

if grep -RIlE '/(Users|home)/(marco|[^/<[:space:]]+)/(Documents|Downloads|Desktop|\.codex)/' \
    --exclude-dir=.git --exclude-dir=binary --exclude-dir=cache \
    --exclude-dir=chroot --exclude='*.png' --exclude='*.jpg' . | grep -q .; then
    echo "Development-machine absolute path found" >&2
    exit 1
fi

if grep -RIlE 'BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{20,}' \
    --exclude-dir=.git --exclude-dir=binary --exclude-dir=cache \
    --exclude-dir=chroot . | grep -q .; then
    echo "Possible credential found" >&2
    exit 1
fi

echo "OBLinux Brand Master v1.0.0 downstream integration validation passed"
