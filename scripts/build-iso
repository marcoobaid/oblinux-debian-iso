#!/bin/bash

set -euo pipefail

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

run() {
    printf '\n==> %s\n' "$*"
    "$@"
}

if [[ ${1-} == --help ]]; then
    cat <<'EOF'
Usage: scripts/build-iso

Fast-forward the clean main branch from origin, perform a purged OBLinux ISO
build, and verify the generated artifact and build identity. Run this script as
the normal builder account; it invokes sudo only for live-build operations.
EOF
    exit 0
fi
[[ $# -eq 0 ]] || die "no arguments are supported (use --help)"
[[ $EUID -ne 0 ]] || die "run this script as the normal builder account, not with sudo"

for command in git lb sudo dpkg sha256sum xorriso file awk grep sed stat cmp; do
    command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done

[[ -f /etc/os-release ]] || die "/etc/os-release is unavailable"
# shellcheck disable=SC1091
. /etc/os-release
[[ ${ID-} == debian ]] || die "the build host must be Debian"
[[ ${VERSION_CODENAME-} == trixie ]] || die "the build host must be Debian 13 (trixie)"
[[ $(dpkg --print-architecture) == amd64 ]] || die "the build host must use amd64"

[[ -d .git ]] || die "$repository_root is not a normal Git working clone"
[[ $(git branch --show-current) == main ]] || die "the build must run from the main branch"
[[ $(git remote get-url origin) == git@github-oblinux-debian-dev:marcoobaid/oblinux-debian-iso-dev.git ]] ||
    die "origin is not the authorized oblinux-debian-iso-dev SSH remote"

if [[ -n $(git status --porcelain --untracked-files=all) ]]; then
    git status --short --branch
    die "the working tree must be clean before updating or building"
fi

run git status --short --branch
run git pull --ff-only origin main

local_head=$(git rev-parse HEAD)
remote_head=$(git rev-parse origin/main)
[[ $local_head == "$remote_head" ]] || die "local main does not exactly match origin/main"
[[ -z $(git status --porcelain --untracked-files=all) ]] ||
    die "the working tree changed unexpectedly during the update"

version=$(cat VERSION)
[[ $version =~ ^[0-9]{2}\.[1-4]\.[0-9]+(-dev)?$ ]] || die "VERSION is invalid: $version"

printf '\nSource commit: %s\n' "$local_head"
printf 'Release version: %s\n' "$version"
printf 'Build filesystem:\n'
df -hP "$repository_root"

printf '\n==> Validating sudo access\n'
sudo -v

run sudo lb clean --purge

available_kib=$(df -Pk "$repository_root" | awk 'NR == 2 {print $4}')
if (( available_kib < 40 * 1024 * 1024 )); then
    printf 'WARNING: less than the recommended 40 GiB is free after cleaning.\n' >&2
    df -hP "$repository_root" >&2
fi

run scripts/validate-branding-integration
run lb config
run lb config --validate

build_started=$(date +%s)
run sudo lb build

[[ -r .build/oblinux-release ]] || die "the build release record is missing"
# Values are generated internally by auto/build and validated again below.
# shellcheck disable=SC1091
. .build/oblinux-release

[[ ${VERSION-} == "$version" ]] || die "build-record VERSION does not match the source VERSION"
[[ ${BUILD_ID-} =~ ^[0-9]{8}-[0-9]{4}$ ]] || die "build-record BUILD_ID is invalid"
[[ ${IMAGE_NAME-} == "oblinux-debian-${version}-${BUILD_ID}" ]] ||
    die "build-record IMAGE_NAME is inconsistent"

iso="${IMAGE_NAME}-amd64.iso"
log="build-logs/build-${BUILD_ID}.log"
[[ -s $iso ]] || die "expected ISO is missing or empty: $iso"
[[ -s $log ]] || die "expected build log is missing or empty: $log"
(( $(stat -c %Y "$iso") >= build_started )) || die "the ISO predates this build invocation"

grep -qx "VERSION=\"$version\"" config/includes.chroot/etc/os-release ||
    die "generated os-release VERSION does not match"
grep -qx "VERSION_ID=\"$version\"" config/includes.chroot/etc/os-release ||
    die "generated os-release VERSION_ID does not match"
grep -qx "BUILD_ID=\"$BUILD_ID\"" config/includes.chroot/etc/os-release ||
    die "generated os-release BUILD_ID does not match"
cmp config/includes.chroot/etc/os-release config/includes.chroot/usr/lib/os-release ||
    die "the two generated os-release files differ"

file "$iso" | grep -q 'ISO 9660' || die "the artifact is not recognized as an ISO 9660 image"
xorriso -indev "$iso" -report_el_torito plain 2>&1 | grep -q 'El Torito' ||
    die "the ISO has no El Torito boot information"

[[ -z $(git status --porcelain --untracked-files=all) ]] ||
    die "the build modified tracked or unignored repository files"
[[ $(git rev-parse HEAD) == "$local_head" ]] || die "HEAD changed during the build"

checksum=$(sha256sum "$iso")

printf '\nBuild and static artifact verification passed.\n'
printf 'Commit: %s\n' "$local_head"
printf 'Version: %s\n' "$version"
printf 'Build ID: %s\n' "$BUILD_ID"
printf 'ISO: %s/%s\n' "$repository_root" "$iso"
printf 'Log: %s/%s\n' "$repository_root" "$log"
printf 'SHA-256: %s\n' "$checksum"
printf '\nBoot, live-session, installation, and hardware acceptance remain separate tests.\n'
