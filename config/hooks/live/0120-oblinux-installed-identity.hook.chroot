#!/bin/sh

set -eu

grub_linux=/etc/grub.d/10_linux
vendor_logo=/usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg
oblinux_vendor_logo=/usr/share/oblinux/branding/oblinux-vendor.svg
vendor_logos=/usr/share/oblinux/vendor-logos
vendor_emblems=/usr/share/oblinux/vendor-emblems
default_avatar=/etc/skel/.face
default_avatar_link=/etc/skel/.face.icon
oblinux_default_avatar=/usr/share/oblinux/branding/oblinux-default-avatar.svg
login_background=/usr/share/backgrounds/oblinux/oblinux-horizon-branded-3840x2160.jpg
login_background_link=/usr/share/images/desktop-base/login-background.svg
gdm_profile=/etc/dconf/profile/gdm
gdm_background=/etc/dconf/db/gdm.d/01-oblinux-background
gdm_database=/etc/dconf/db/gdm
expected='    Ubuntu|Kubuntu|*GNU/Linux)'
replacement='    OBLinux|Ubuntu|Kubuntu|*GNU/Linux)'

if grep -Fqx "$expected" "$grub_linux"; then
    sed -i "s/^    Ubuntu|Kubuntu|\*GNU\/Linux)$/    OBLinux|Ubuntu|Kubuntu|*GNU\/Linux)/" \
        "$grub_linux"
elif ! grep -Fqx "$replacement" "$grub_linux"; then
    echo "Unexpected GRUB title logic in $grub_linux" >&2
    exit 1
fi

grep -qx 'PRETTY_NAME="OBLinux Proof of Concept (Debian 13)"' /etc/os-release
grep -qx 'ID=oblinux' /etc/os-release
grep -qx 'ID_LIKE=debian' /etc/os-release
grep -qx 'LOGO=oblinux-logo' /etc/os-release
cmp /etc/os-release /usr/lib/os-release
grep -qx 'Theme=oblinux' /etc/plymouth/plymouthd.conf
grep -qx 'GRUB_THEME="/usr/share/grub/themes/oblinux/theme.txt"' \
    /etc/default/grub.d/99-oblinux.cfg

# Debian resolves both GNOME Control Center's emblem and GDM's bottom vendor
# mark through one vendor-logos alternatives group. Register a complete
# OBLinux candidate with the same slave contract as desktop-base, then select
# it explicitly. Debian's candidate remains installed and recoverable.
test -f "$oblinux_vendor_logo"
test -f "$vendor_logos/logo-text-version-64.png"
if dpkg-divert --list "$vendor_logo" | grep -Fq "local diversion of $vendor_logo"; then
    rm -f "$vendor_logo"
    dpkg-divert --quiet --local --rename --remove "$vendor_logo"
fi
update-alternatives --install \
    /usr/share/images/vendor-logos vendor-logos "$vendor_logos" 100 \
    --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor.png \
        emblem-vendor-64 "$vendor_emblems/emblem-vendor-64.png" \
    --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor.png \
        emblem-vendor-128 "$vendor_emblems/emblem-vendor-128.png" \
    --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor.png \
        emblem-vendor-256 "$vendor_emblems/emblem-vendor-256.png" \
    --slave "$vendor_logo" emblem-vendor-scalable "$oblinux_vendor_logo" \
    --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-symbolic.png \
        emblem-vendor-symbolic-64 "$vendor_emblems/emblem-vendor-symbolic-64.png" \
    --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-symbolic.png \
        emblem-vendor-symbolic-128 "$vendor_emblems/emblem-vendor-symbolic-128.png" \
    --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-symbolic.png \
        emblem-vendor-symbolic-256 "$vendor_emblems/emblem-vendor-symbolic-256.png" \
    --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-symbolic.svg \
        emblem-vendor-symbolic-scalable "$oblinux_vendor_logo" \
    --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-white.png \
        emblem-vendor-white-64 "$vendor_emblems/emblem-vendor-white-64.png" \
    --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-white.png \
        emblem-vendor-white-128 "$vendor_emblems/emblem-vendor-white-128.png" \
    --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-white.png \
        emblem-vendor-white-256 "$vendor_emblems/emblem-vendor-white-256.png" \
    --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-white.svg \
        emblem-vendor-white-scalable "$oblinux_vendor_logo"
update-alternatives --set vendor-logos "$vendor_logos"
test "$(readlink -f /usr/share/images/vendor-logos)" = "$vendor_logos"

# desktop-base supplies a Debian-branded skeleton avatar. Calamares copies it
# into each newly created home, where GDM then presents it as the user's face.
# Preserve Debian's package file and replace only the account-creation default;
# existing homes and user-selected account photos are never modified here.
test -f "$oblinux_default_avatar"
if ! dpkg-divert --list "$default_avatar" | grep -Fq "local diversion of $default_avatar"; then
    dpkg-divert --quiet --local --rename --add "$default_avatar"
fi
install -m 0644 "$oblinux_default_avatar" "$default_avatar"
ln -sfn .face "$default_avatar_link"

test -r "$default_avatar.distrib"
cmp "$default_avatar" "$oblinux_default_avatar"
test "$(readlink "$default_avatar_link")" = .face

# Retain the branded login-background alternative for display managers and
# consumers that honor it. GDM's bottom product mark is controlled separately
# by the vendor-logos alternative above. The GNOME desktop, session lock
# screen, and user-selected account photos remain independently configurable.
test -r "$login_background"
update-alternatives --install \
    "$login_background_link" \
    desktop-login-background \
    "$login_background" \
    100
update-alternatives --set desktop-login-background "$login_background"
test "$(readlink -f "$login_background_link")" = "$login_background"

# Give only the GDM greeter an image-free OBLinux gradient. This dedicated
# dconf database does not change a user's desktop wallpaper or session lock
# screen, while the existing vendor-logos alternative continues to provide
# the product mark at the bottom of the greeter.
test -r "$gdm_profile"
test -r "$gdm_background"
grep -qx 'user-db:user' "$gdm_profile"
grep -qx 'system-db:gdm' "$gdm_profile"
grep -qx 'file-db:/usr/share/gdm/greeter-dconf-defaults' "$gdm_profile"
grep -qx "primary-color='#111820'" "$gdm_background"
grep -qx "secondary-color='#1B2836'" "$gdm_background"
grep -qx "color-shading-type='vertical'" "$gdm_background"
grep -qx "picture-options='none'" "$gdm_background"
command -v dconf >/dev/null
dconf update
test -s "$gdm_database"

gtk-update-icon-cache --force /usr/share/icons/hicolor
