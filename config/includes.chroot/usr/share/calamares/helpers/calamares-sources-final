#!/bin/sh

set -eu

# This is an OBLinux override of the helper supplied by
# calamares-settings-debian. Calamares runs it in the live environment after
# installation and passes no target-root argument, so retain Debian's proven
# target discovery method while making the resulting policy explicit.
CHROOT=$(mount | awk '$1 == "proc" && $3 ~ /calamares/ { sub("/proc$", "", $3); print $3; exit }')
RELEASE="trixie"

if [ -z "${CHROOT}" ] || [ ! -d "${CHROOT}/etc/apt" ]; then
	echo "Unable to locate the Calamares target root" >&2
	exit 1
fi

cat > "${CHROOT}/etc/apt/sources.list" <<EOF
# Managed by OBLinux. See https://wiki.debian.org/SourcesList.
deb http://deb.debian.org/debian ${RELEASE} main contrib non-free non-free-firmware
deb http://deb.debian.org/debian ${RELEASE}-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security ${RELEASE}-security main contrib non-free non-free-firmware
EOF

# Ensure no build-time or live-media source remains enabled.
rm -f "${CHROOT}/etc/apt/sources.list.d/base.list"
rm -f "${CHROOT}/etc/apt/sources.list.d/debian-live-media.list"

# locale.conf is OBLinux-owned live-image content because Debian's Calamares
# settings package does not ship it. Do not leave this installer-only GeoIP
# configuration in the installed target.
rm -f "${CHROOT}/etc/calamares/modules/locale.conf"

exit 0
