Window.SetBackgroundTopColor(0.067, 0.094, 0.125);
Window.SetBackgroundBottomColor(0.106, 0.157, 0.212);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo = Image("logo.png");
logo_size = Math.Min(screen_width, screen_height) * 0.24;
logo = logo.Scale(logo_size, logo_size);
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(
    (screen_width - logo.GetWidth()) / 2,
    (screen_height - logo.GetHeight()) / 2 - logo.GetHeight() * 0.18,
    10
);

progress_background = Image("progress-background.png");
progress_fill = Image("progress-fill.png");
progress_width = Math.Min(screen_width * 0.32, 420);
progress_height = 6;
progress_x = (screen_width - progress_width) / 2;
progress_y = (screen_height + logo.GetHeight()) / 2 + 28;

progress_background = progress_background.Scale(progress_width, progress_height);
progress_background_sprite = Sprite(progress_background);
progress_background_sprite.SetPosition(progress_x, progress_y, 10);

progress_fill_sprite = Sprite();

fun boot_progress_callback(duration, progress) {
    fill_width = Math.Max(2, progress_width * progress);
    fill = progress_fill.Scale(fill_width, progress_height);
    progress_fill_sprite.SetImage(fill);
    progress_fill_sprite.SetPosition(progress_x, progress_y, 11);
}

message_sprite = Sprite();

fun message_callback(text) {
    message = Image.Text(text, 0.949, 0.961, 0.969);
    message_sprite.SetImage(message);
    message_sprite.SetPosition(
        (screen_width - message.GetWidth()) / 2,
        progress_y + 24,
        12
    );
}

prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    prompt_image = Image.Text(prompt, 0.949, 0.961, 0.969);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(
        (screen_width - prompt_image.GetWidth()) / 2,
        progress_y + 24,
        20
    );

    bullet_text = "";
    for (index = 0; index < bullets; index++)
        bullet_text += "*";

    bullets_image = Image.Text(bullet_text, 0.298, 0.788, 0.847);
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetPosition(
        (screen_width - bullets_image.GetWidth()) / 2,
        progress_y + 52,
        20
    );
}

fun display_question_callback(prompt, entry) {
    display_password_callback(prompt, 0);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
