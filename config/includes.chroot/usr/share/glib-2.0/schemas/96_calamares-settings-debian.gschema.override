# OBLinux live-session defaults. This deliberately replaces the file owned by
# calamares-settings-debian so package removal also removes these live-only
# settings from the installed system.

# Match the Arch live-session dash: Files, Firefox, Terminal, installer. GNOME
# renders Show Applications after the favorites rather than as a desktop file.
[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'org.gnome.Ptyxis.desktop', 'calamares-install-debian.desktop']

# Never lock or blank the live installer session while installation is active.
[org.gnome.desktop.lockdown]
disable-lock-screen=true

[org.gnome.desktop.screensaver]
lock-enabled=false

[org.gnome.desktop.session]
idle-delay=0

# Never suspend the live installer session on AC or battery power.
[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
